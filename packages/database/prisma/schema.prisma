// Nexvo Database Schema
// Customer Engagement Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATION & USERS
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  logo      String?

  // Settings
  settings     Json @default("{}")
  widgetConfig Json @default("{}")

  // Plan (legacy field, use subscription for full details)
  plan PlanType @default(FREE)

  // Billing
  billingEmail   String?
  billingCountry String? // ISO country code (IN, US, etc.)
  currency       String  @default("USD") // USD, INR, EUR, etc.

  // Payment Gateway Customer IDs
  stripeCustomerId    String? @unique
  razorpayCustomerId  String? @unique

  // Tax Information (for India GST, etc.)
  taxId     String? // GST number for India
  taxIdType String? // gstin, vat, etc.

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  visitors        Visitor[]
  conversations   Conversation[]
  chatbots        Chatbot[]
  departments     Department[]
  cannedResponses CannedResponse[]
  apiKeys         ApiKey[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  payments        Payment[]
  usageRecords    UsageRecord[]
  promoCodes      PromoCodeUsage[]

  @@index([slug])
  @@index([stripeCustomerId])
  @@index([razorpayCustomerId])
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  avatar       String?
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(OFFLINE)

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Department
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Settings
  settings Json @default("{}")

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  // Relations
  conversations Conversation[] @relation("OperatorConversations")
  messages      Message[]
  sessions      UserSession[]

  @@index([organizationId])
  @@index([email])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

enum UserRole {
  OWNER
  ADMIN
  SUPERVISOR
  OPERATOR
}

enum UserStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

model Department {
  id          String  @id @default(cuid())
  name        String
  description String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Routing rules
  routingRules Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  conversations Conversation[]

  @@index([organizationId])
}

// ============================================
// VISITORS & TRACKING
// ============================================

model Visitor {
  id String @id @default(cuid())

  // Identity
  visitorToken String  @unique
  email        String?
  name         String?
  phone        String?
  avatar       String?

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Metadata
  metadata Json     @default("{}")
  tags     String[] @default([])

  // Scoring
  score Int @default(0)

  // Timestamps
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // Relations
  sessions      VisitorSession[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([visitorToken])
  @@index([email])
}

model VisitorSession {
  id String @id @default(cuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  // Session Info
  ipAddress String?
  userAgent String?

  // Geo
  country String?
  city    String?
  region  String?

  // Traffic Source
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Landing
  landingPage String?

  // Device
  device  String? // desktop, mobile, tablet
  browser String?
  os      String?

  // Timestamps
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Relations
  pageViews PageView[]

  @@index([visitorId])
  @@index([startedAt])
}

model PageView {
  id String @id @default(cuid())

  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  url   String
  title String?

  // Time
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?
  timeSpent Int? // seconds

  @@index([sessionId])
}

// ============================================
// CONVERSATIONS & MESSAGES
// ============================================

model Conversation {
  id String @id @default(cuid())

  // Organization
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Visitor
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  // Operator
  operatorId String?
  operator   User?   @relation("OperatorConversations", fields: [operatorId], references: [id])

  // Department
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Status
  status   ConversationStatus @default(PENDING)
  priority Priority           @default(NORMAL)

  // Channel
  channel Channel @default(WIDGET)

  // Metadata
  subject  String?
  tags     String[] @default([])
  metadata Json     @default("{}")

  // Feedback
  rating   Int?
  feedback String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?
  firstResponseAt DateTime?

  // Relations
  messages Message[]

  @@index([organizationId])
  @@index([visitorId])
  @@index([operatorId])
  @@index([status])
  @@index([createdAt])
}

enum ConversationStatus {
  PENDING // Waiting for operator
  ACTIVE // In progress
  WAITING // Waiting for visitor response
  RESOLVED // Closed successfully
  MISSED // No response
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Channel {
  WIDGET
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TELEGRAM
  EMAIL
  SMS
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender
  senderType SenderType
  senderId   String? // visitorId or oduserId
  sender     User?   @relation(fields: [senderId], references: [id])

  // Content
  content     String
  contentType MessageType @default(TEXT)

  // Attachments
  attachments Json[] @default([])

  // Metadata
  metadata Json @default("{}")

  // Status
  status MessageStatus @default(SENT)

  // Timestamps
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([conversationId])
  @@index([createdAt])
}

enum SenderType {
  VISITOR
  OPERATOR
  BOT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VIDEO
  AUDIO
  CARD // Rich card
  BUTTONS // Quick replies
  FORM // Form input
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ============================================
// CHATBOTS
// ============================================

model Chatbot {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Type
  type ChatbotType @default(FLOW)

  // Flow data (for visual builder)
  flowData Json @default("{}")

  // Settings
  settings Json @default("{}")

  // Status
  isActive Boolean @default(false)

  // Triggers
  triggers Json @default("[]")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum ChatbotType {
  FLOW // Visual flow-based
  AI // AI-powered
  HYBRID // Flow + AI
}

// ============================================
// CANNED RESPONSES
// ============================================

model CannedResponse {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  shortcut String // e.g., /hello
  title    String
  content  String

  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key  String @unique
  name String

  // Permissions
  permissions String[] @default([])

  // Usage
  lastUsedAt DateTime?

  // Status
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([key])
  @@index([organizationId])
}

// ============================================
// FILE UPLOADS
// ============================================

model Upload {
  id String @id @default(cuid())

  organizationId String
  userId         String?

  // File info
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  folder       String // avatars, attachments, widget

  // Timestamps
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([folder])
}

// ============================================
// SUBSCRIPTION & BILLING
// ============================================

model PricingPlan {
  id   String @id @default(cuid())
  name String @unique // free, starter, pro, enterprise

  // Display
  displayName String
  description String?
  badge       String? // "Popular", "Best Value", etc.

  // Pricing (store in smallest unit - cents/paise)
  priceMonthlyUSD  Int @default(0) // in cents
  priceYearlyUSD   Int @default(0) // in cents (annual)
  priceMonthlyINR  Int @default(0) // in paise
  priceYearlyINR   Int @default(0) // in paise (annual)

  // Features & Limits
  features Json @default("[]") // ["Feature 1", "Feature 2"]
  limits   Json @default("{}") // { "operators": 5, "chats": 1000, "visitors": 10000 }

  // Limits breakdown
  maxOperators        Int @default(1)
  maxChatsPerMonth    Int @default(100)
  maxVisitorsPerMonth Int @default(1000)
  maxChatbots         Int @default(1)
  maxDepartments      Int @default(1)
  historyRetentionDays Int @default(30)

  // Feature flags
  hasAnalytics        Boolean @default(false)
  hasCustomBranding   Boolean @default(false)
  hasApiAccess        Boolean @default(false)
  hasWhitelabel       Boolean @default(false)
  hasPrioritySupport  Boolean @default(false)
  hasAIChatbot        Boolean @default(false)
  hasMultiChannel     Boolean @default(false)

  // Status
  isActive   Boolean @default(true)
  isCustom   Boolean @default(false) // For enterprise custom plans
  sortOrder  Int     @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions Subscription[]

  @@index([name])
  @@index([isActive])
}

model Subscription {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   PricingPlan @relation(fields: [planId], references: [id])

  // Billing Cycle
  billingCycle BillingCycle @default(MONTHLY)
  currency     String       @default("USD")

  // Status
  status SubscriptionStatus @default(TRIALING)

  // Pricing at time of subscription (in smallest unit)
  pricePerPeriod Int @default(0)

  // Trial
  trialEndsAt DateTime?

  // Current Period
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  // Cancellation
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  cancelReason      String?

  // Payment Gateway References
  paymentGateway           PaymentGateway?
  stripeSubscriptionId     String?         @unique
  razorpaySubscriptionId   String?         @unique
  instamojoSubscriptionId  String?         @unique

  // Promo/Discount
  discountPercent Int     @default(0)
  discountEndsAt  DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoices Invoice[]
  payments Payment[]

  @@index([organizationId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([stripeSubscriptionId])
  @@index([razorpaySubscriptionId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
  QUARTERLY
  LIFETIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum PaymentGateway {
  STRIPE
  RAZORPAY
  INSTAMOJO
  PAYTM
  UPI
  MANUAL
}

model Invoice {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  // Invoice Details
  invoiceNumber String @unique

  // Amounts (in smallest unit - cents/paise)
  subtotal    Int @default(0)
  discount    Int @default(0)
  tax         Int @default(0)
  total       Int @default(0)
  amountPaid  Int @default(0)
  amountDue   Int @default(0)

  currency String @default("USD")

  // Tax Details
  taxRate   Float  @default(0) // e.g., 18 for 18% GST
  taxType   String? // GST, VAT, etc.

  // Status
  status InvoiceStatus @default(DRAFT)

  // Dates
  issuedAt DateTime @default(now())
  dueAt    DateTime
  paidAt   DateTime?

  // Period covered
  periodStart DateTime?
  periodEnd   DateTime?

  // Payment Gateway References
  stripeInvoiceId    String? @unique
  razorpayInvoiceId  String? @unique

  // Line Items
  lineItems Json @default("[]") // [{ description, quantity, unitPrice, amount }]

  // Notes
  notes     String?
  footerNote String?

  // PDF
  pdfUrl String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payments Payment[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  VOID
  REFUNDED
  PARTIALLY_PAID
  OVERDUE
}

model Payment {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // Amount (in smallest unit)
  amount   Int
  currency String @default("USD")

  // Payment Method
  paymentGateway PaymentGateway
  paymentMethod  String? // card, upi, netbanking, wallet, etc.

  // Status
  status PaymentStatus @default(PENDING)

  // Gateway References
  stripePaymentId    String? @unique
  razorpayPaymentId  String? @unique
  instamojoPaymentId String? @unique
  paytmPaymentId     String? @unique
  upiTransactionId   String? @unique

  // UPI Specific
  upiId     String? // e.g., yourname@upi
  upiVpa    String? // Virtual Payment Address

  // Card Details (masked)
  cardLast4 String?
  cardBrand String? // visa, mastercard, rupay, etc.

  // Failure
  failureCode    String?
  failureMessage String?

  // Refund
  refundedAmount Int       @default(0)
  refundedAt     DateTime?
  refundReason   String?

  // Metadata
  metadata Json @default("{}")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([status])
  @@index([paymentGateway])
  @@index([stripePaymentId])
  @@index([razorpayPaymentId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

// ============================================
// PROMO CODES & DISCOUNTS
// ============================================

model PromoCode {
  id String @id @default(cuid())

  code        String @unique
  description String?

  // Discount
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Int          @default(0) // percentage or fixed amount in cents/paise
  discountCurrency String?    // required for FIXED type

  // Applicability
  applicablePlans String[] @default([]) // empty = all plans

  // Validity
  validFrom    DateTime  @default(now())
  validUntil   DateTime?
  maxUses      Int?      // null = unlimited
  maxUsesPerOrg Int      @default(1)
  usedCount    Int       @default(0)

  // Duration
  durationMonths Int? // how long the discount applies, null = forever

  // Conditions
  minAmount        Int?    // minimum purchase amount
  firstTimeOnly    Boolean @default(false)
  newSignupsOnly   Boolean @default(false)

  // Campaign
  campaign String? // new_year_2025, diwali_sale, etc.

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  usages PromoCodeUsage[]

  @@index([code])
  @@index([isActive])
  @@index([campaign])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model PromoCodeUsage {
  id String @id @default(cuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Discount applied
  discountApplied Int // amount in cents/paise
  currency        String

  // Timestamps
  usedAt DateTime @default(now())

  @@unique([promoCodeId, organizationId])
  @@index([promoCodeId])
  @@index([organizationId])
}

// ============================================
// USAGE TRACKING & METERING
// ============================================

model UsageRecord {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Period
  periodStart DateTime
  periodEnd   DateTime

  // Usage Metrics
  chatsCount       Int @default(0)
  messagesCount    Int @default(0)
  visitorsCount    Int @default(0)
  operatorsCount   Int @default(0)
  chatbotsCount    Int @default(0)
  fileStorageBytes BigInt @default(0)
  apiCallsCount    Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([periodStart])
}

// ============================================
// PAYMENT WEBHOOKS LOG
// ============================================

model WebhookEvent {
  id String @id @default(cuid())

  // Source
  gateway   PaymentGateway
  eventType String
  eventId   String @unique

  // Payload
  payload Json

  // Processing
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([gateway])
  @@index([eventType])
  @@index([processed])
}
