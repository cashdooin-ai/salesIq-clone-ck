# Stripe Payment Gateway Configuration
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Stripe Webhook Secret
# Get this from: https://dashboard.stripe.com/webhooks
# Or use Stripe CLI: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment Gateway Selection
# Options: stripe, razorpay, paytm, etc.
PAYMENT_GATEWAY=stripe

# Optional: Stripe Connect (for marketplace/platform features)
# STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Stripe Tax Settings
# STRIPE_TAX_ENABLED=true
# STRIPE_TAX_RATE_ID=txr_xxxxxxxxxxxxxxxxxxxxx

# Optional: Default Currency
# STRIPE_DEFAULT_CURRENCY=usd

# Optional: Application Fee (for platforms)
# STRIPE_APPLICATION_FEE_PERCENT=10
