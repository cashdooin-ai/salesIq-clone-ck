# Nexvo API - Environment Variables Example
# Copy this file to .env and update with your values

# ======================
# ENVIRONMENT
# ======================
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ======================
# URLS
# ======================
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
WIDGET_URL=http://localhost:3002

# ======================
# CORS
# ======================
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ======================
# DATABASE
# ======================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexvo

# ======================
# REDIS
# ======================
REDIS_URL=redis://localhost:6379

# ======================
# JWT
# ======================
JWT_SECRET=change-this-secret-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-use-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# ENCRYPTION
# ======================
# Must be exactly 32 characters
ENCRYPTION_KEY=change-this-32-char-encryption!

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ======================
# EMAIL / SMTP
# ======================
# SMTP server configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# The "From" address for all emails
EMAIL_FROM=noreply@nexvo.io

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password as SMTP_PASS

# Other SMTP providers:
# - SendGrid: smtp.sendgrid.net:587
# - Mailgun: smtp.mailgun.org:587
# - AWS SES: email-smtp.us-east-1.amazonaws.com:587
# - Postmark: smtp.postmarkapp.com:587

# ======================
# FILE STORAGE (S3)
# ======================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nexvo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# For AWS S3, use:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_REGION=us-east-1

# ======================
# OPENAI (Optional)
# ======================
OPENAI_API_KEY=your-openai-api-key-here

# ======================================
# PAYMENT GATEWAYS
# ======================================

# ======================
# STRIPE (International)
# ======================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# Webhook secret for verifying Stripe webhooks
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Note: For production, use live keys (sk_live_..., pk_live_...)

# ======================
# RAZORPAY (India)
# ======================
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret for verifying Razorpay webhooks
# Get this from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Note: For production, use live keys (rzp_live_...)

# ======================
# INSTAMOJO (India)
# ======================
# Get your keys from: https://www.instamojo.com/integrations
INSTAMOJO_API_KEY=your_instamojo_api_key
INSTAMOJO_AUTH_TOKEN=your_instamojo_auth_token
INSTAMOJO_SALT=your_instamojo_salt

# Set to true for sandbox/testing
INSTAMOJO_SANDBOX=true

# Production URL: https://www.instamojo.com/api/1.1/
# Sandbox URL: https://test.instamojo.com/api/1.1/

# ======================
# PAYTM (India)
# ======================
# Get your credentials from: https://dashboard.paytm.com/
PAYTM_MERCHANT_ID=your_merchant_id
PAYTM_MERCHANT_KEY=your_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL_ID=WEB

# Set to true for sandbox/testing
PAYTM_SANDBOX=true

# ======================
# UPI DIRECT (India)
# ======================
# Your business UPI VPA for receiving payments
UPI_PAYEE_VPA=yourcompany@upi
UPI_PAYEE_NAME=Nexvo
