# Nexvo Production Environment Variables
# Copy to .env and update with your values

# ===================
# DOMAIN & SSL
# ===================
DOMAIN=nexvo.io
ACME_EMAIL=admin@nexvo.io

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
TRAEFIK_AUTH=admin:$$apr1$$xxx

# ===================
# DATABASE
# ===================
DB_USER=nexvo
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=nexvo

# ===================
# REDIS
# ===================
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ===================
# SECURITY
# ===================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET

# Must be exactly 32 characters
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_ENCRYPT_KEY!

# ===================
# EMAIL (Resend recommended)
# ===================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@nexvo.io

# ===================
# STORAGE (Cloudflare R2)
# ===================
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_BUCKET=nexvo
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key

# ===================
# PAYMENTS - STRIPE (International)
# ===================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===================
# PAYMENTS - RAZORPAY (India)
# ===================
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
